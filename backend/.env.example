DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional locally. If configured, this must be a PostgreSQL URL.
DATABASE_URL=
DB_CONN_MAX_AGE=60

# Set these in the Django host's secret environment settings.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional SMTP settings, if email notifications are enabled.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
